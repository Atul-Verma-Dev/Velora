# Velora backend environment configuration.
# Copy to .env and adjust for your deployment. Never commit real credentials.

# PostgreSQL connection (pgvector-backed). Adjust host/port/user/password/db as needed.
DATABASE_URL=postgres://velora:velora_dev@127.0.0.1:5433/velora

# Google GenAI API key (Phase 3 multimodal search + embeddings). Optional for Phase 1.
GOOGLE_API_KEY=

# Embedding model for visual embeddings (Gemini Embedding 2).
GEN_MODEL_EMBEDDING=gemini-embedding-2
# Flash-Lite for structured attribute extraction.
GEN_MODEL_FLASH=gemini-3.5-flash-lite

# API behaviour
API_BASE_URL=http://127.0.0.1:8000
DEBUG=true
LOG_LEVEL=INFO

# Complete the Look configuration (mirrors frontend config defaults)
DEEP_BUNDLE_GATE=2000
OFFERS_ENABLED=true
# Aesthetic compatibility threshold for vector similarity. Calibrated on this
# catalogue's image embeddings (p50 0.69, p90 0.78; complementary pairs 0.66-0.76),
# so 0.72 gates the vector path without hiding genuine pairings.
AESTHETIC_THRESHOLD=0.72
# Metadata fallback score threshold (0-1 scale) when embeddings are unavailable.
METADATA_COMPAT_THRESHOLD=0.60

# Marginal shipping cost default (INR) used when a product omits it.
DEFAULT_MARGINAL_SHIPPING=45

# Assumed cost of one returned unit (reverse pickup + QC + re-listing), used to
# value reverse logistics avoided when an aging piece sells in a bundle.
REVERSE_LOGISTICS_COST=150
